---
import { profile } from '../data/profile';
interface Props { title?: string; description?: string }
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { title = `${profile.name}｜${profile.title}`, description = profile.tagline } = Astro.props;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${base}/`}>{profile.name}</a>
      <nav>
        <a href={`${base}/#projects`}>作品</a>
        <a href={`${base}/#experience`}>經歷</a>
        <a href={`${base}/#skills`}>技能</a>
        <a href={`${base}/#contact`}>聯絡</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">© {new Date().getFullYear()} {profile.name}</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9; --fg: #1c1917; --muted: #78716c; --accent: #2563eb; --card: #fff; --line: #e7e5e4;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0c0a09; --fg: #f5f5f4; --muted: #a8a29e; --accent: #60a5fa; --card: #1c1917; --line: #292524; }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0; background: var(--bg); color: var(--fg); line-height: 1.7;
    font-family: system-ui, -apple-system, "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
  }
  a { color: var(--accent); }
  main, .site-header, .site-footer { max-width: 760px; margin: 0 auto; padding: 0 1.25rem; }
  .site-header { display: flex; justify-content: space-between; align-items: center; padding-top: 1.5rem; padding-bottom: 1.5rem; }
  .site-header nav { display: flex; gap: 1.25rem; }
  .site-header a { text-decoration: none; color: var(--fg); }
  .site-header nav a:hover { color: var(--accent); }
  .brand { font-weight: 700; }
  section { padding: 2.5rem 0; border-top: 1px solid var(--line); }
  h1 { font-size: clamp(2rem, 6vw, 3rem); line-height: 1.2; margin: 0 0 .5rem; }
  h2 { font-size: 1.25rem; margin: 0 0 1.25rem; }
  .site-footer { padding-top: 2rem; padding-bottom: 3rem; color: var(--muted); font-size: .875rem; }
</style>
