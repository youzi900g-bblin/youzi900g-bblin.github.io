---
import '../styles/site.css';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
interface Props { title?: string; description?: string; image?: string }
const { title, description = profile.tagline, image = '/works/portrait-duo.jpg' } = Astro.props;
const pageTitle = title ? `${title}｜${profile.name}` : `${profile.name}｜視覺設計與影音剪輯`;
const path = Astro.url.pathname;
const current = (p: string) => (path === p || path.startsWith(p) ? 'page' : undefined);
const site = 'https://youzi900g-bblin.github.io';
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${site}${image}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gloock&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">跳到主要內容</a>
    <header class="nav on-deep">
      <div class="container">
        <a class="wordmark" href="/" aria-label={`${profile.name}，回到首頁`}>{profile.name}</a>
        <nav class="nav__links" aria-label="主選單">
          <a href="/works/" aria-current={current('/works')}>作品</a>
          <a href="/about/" aria-current={current('/about')}>關於</a>
          <a href="#contact">聯絡</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>

<style is:global>
  html, body { overflow-x: clip; }
</style>
