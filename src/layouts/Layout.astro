---
import '../styles/site.css';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
interface Props { title?: string; description?: string; image?: string }
const { title, description = profile.tagline, image = '/og.jpg' } = Astro.props;
const pageTitle = title ? `${title}｜${profile.name}` : `${profile.name}｜視覺設計與影音剪輯`;
const path = Astro.url.pathname;
const current = (p: string) => (path === p || path.startsWith(p) ? 'page' : undefined);
const site = 'https://youzi900g-bblin.github.io';
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${site}${image}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="theme-color" content="#081328" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gloock&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@900&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#main">跳到主要內容</a>
    <header class="nav on-deep">
      <div class="container">
        <a class="wordmark" href="/" aria-label={`${profile.name}，回到首頁`}>{profile.name}</a>
        <nav class="nav__links" aria-label="主選單">
          <a href="/works/" aria-current={current('/works')}>作品</a>
          <a href="/about/" aria-current={current('/about')}>關於</a>
          <a href="#contact">聯絡</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <Footer />
    <script>
      // 捲動顯現：進入畫面時淡入並上移一點；減少動態設定下完全不啟用
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const items = document.querySelectorAll<HTMLElement>('.print, .wcard, .step, .fact, .detail__media .sheet, .awards li, .me-photos > *, .bw__grid > *');
        items.forEach((el) => el.classList.add('reveal'));
        const io = new IntersectionObserver((entries) => {
          let k = 0;
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            (e.target as HTMLElement).style.transitionDelay = `${Math.min(k++, 4) * 70}ms`;
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  html, body { overflow-x: clip; }
</style>
