---
import '../styles/site.css';
import { profile } from '../data/profile';
interface Props { title?: string; description?: string }
const { title = `${profile.name}｜視覺設計與影音剪輯`, description = profile.tagline } = Astro.props;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;700;900&family=Noto+Sans+TC:wght@400;700;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="nav">
      <div class="container">
        <a class="wordmark" href="/">{profile.name}</a>
        <nav class="nav__links" aria-label="主選單">
          <a href="/#works">作品</a>
          <a href="/#about">關於</a>
          <a href="/#experience">經歷</a>
          <a href="/#contact">聯絡</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="footer">
      <div class="container">
        <span>{profile.name}</span>
        <span class="muted">© {new Date().getFullYear()}</span>
      </div>
    </footer>
  </body>
</html>
