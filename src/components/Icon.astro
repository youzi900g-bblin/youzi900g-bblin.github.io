---
// 線條圖示（24×24，與 Sparkle 同一套風格）。name 對應作品分類與時間線節點。
interface Props { name: string; size?: number; class?: string }
const { name, size = 22, class: cls = '' } = Astro.props;
const icons: Record<string, string> = {
  all: '<rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><rect x="13" y="13" width="7" height="7" rx="1"/>',
  illustration: '<path d="M12 3l5 7.5-5 10.5-5-10.5z"/><circle cx="12" cy="10" r="1.3"/><path d="M12 11.3V21"/>',
  handdrawn: '<path d="M4 20l1-4L16 5l3 3L8 19z"/><path d="M14 7l3 3"/>',
  graphic: '<rect x="5" y="3" width="14" height="18" rx="1"/><circle cx="12" cy="10" r="3"/><path d="M8.5 17h7"/>',
  type: '<path d="M3 19L8 6l5 13M5 14h6"/><circle cx="18" cy="15.2" r="2.6"/><path d="M20.6 12.6V19"/>',
  video: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M10 9.2v5.6l4.8-2.8z"/>',
  game: '<rect x="3" y="8" width="18" height="10" rx="3.5"/><path d="M8 10.8v4.4M5.8 13h4.4"/><circle cx="15.5" cy="12" r=".9"/><circle cx="18" cy="14.2" r=".9"/>',
  editorial: '<path d="M4 5.5c0-.6.4-1 1-1h6c.6 0 1 .4 1 1V19c0-.6-.4-1-1-1H5c-.6 0-1-.4-1-1z"/><path d="M20 5.5c0-.6-.4-1-1-1h-6c-.6 0-1 .4-1 1V19c0-.6.4-1 1-1h6c.6 0 1-.4 1-1z"/>',
  pencil: '<path d="M4 20l1-4L16 5l3 3L8 19z"/><path d="M14 7l3 3"/>',
  school: '<path d="M3 10l9-6 9 6"/><path d="M5 10v9h14v-9"/><path d="M9.5 19v-5h5v5"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="M15.6 8.4l-2.1 5.1-5.1 2.1 2.1-5.1z"/>',
  easel: '<path d="M4 4h16v11H4z"/><path d="M12 15v5M8 20l4-5 4 5"/>',
  laptop: '<rect x="5" y="5" width="14" height="10" rx="1"/><path d="M3 19h18"/>',
};
const body = icons[name] ?? icons.all;
---
<svg class={`icon ${cls}`} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={body} />
