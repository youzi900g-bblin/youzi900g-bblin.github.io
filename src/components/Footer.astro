---
import { profile } from '../data/profile';
import Sparkle from './Sparkle.astro';
---
<footer class="site-footer on-deep" id="contact">
  <div class="contact">
    <figure class="contact__photo">
      <img class="contact__img" src="/works/xray-duo.webp" alt="牙齒全景 X 光片，上下排牙齒戴有矯正器" width="1440" height="650" loading="lazy" />
    </figure>
    <div class="container contact__inner">
      <div class="contact__text">
        <Sparkle class="spark spark--contact" size={44} />
        <div class="head"><h2>Contact</h2><span class="cjk">聯絡</span></div>
        <p class="contact__lead">接案與合作，歡迎來信洽詢。</p>
        <a class="contact__mail" href={`mailto:${profile.email}`}>{profile.email}</a>
        <p class="contact__tel"><span class="contact__label">電話</span> <a href={`tel:${profile.phone.replace(/-/g, '')}`}>{profile.phone}</a></p>
        <div class="actions">
          <a class="btn btn--fill" href="/Lin-Xiang-Yi-Resume.pdf" download>下載履歷（PDF）</a>
        </div>
      </div>
    </div>
  </div>
  <div class="footer__bar">
    <div class="container footer__row">
      <span>{profile.name}</span>
      <nav class="footer__links" aria-label="頁尾">
        <a href="/works/">作品</a>
        <a href="/about/">關於</a>
        <a href="/about/me/">更多的我</a>
      </nav>
      <span class="muted">© {new Date().getFullYear()}</span>
    </div>
  </div>
</footer>
