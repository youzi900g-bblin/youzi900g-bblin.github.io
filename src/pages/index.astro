---
import Layout from '../layouts/Layout.astro';
import Sparkle from '../components/Sparkle.astro';
import { profile } from '../data/profile';
import { works, listedWorks, featuredSlugs, bySlug, categoryLabel } from '../data/works';
import { timeline } from '../data/timeline';
const pad = (n: number) => String(n).padStart(2, '0');
const featured = featuredSlugs.map(bySlug);
const path = [timeline[0], timeline[1], timeline[2], timeline[4], timeline[5]];
---
<Layout>
  <section class="hero on-deep" aria-label="首頁">
    <span class="hero__edge">Portfolio, November 2026</span>
    <figure class="hero__photo">
      <img class="hero__img" src="/works/portrait-duo.jpg" alt="林湘儀的自畫像插畫" width="1080" height="780" />
      <img class="hero__sig" src="/works/signature.png" alt="" width="456" height="57" />
    </figure>
    <div class="container hero__inner">
      <div class="hero__text">
        <Sparkle class="spark spark--hero" size={44} />
        <h1 aria-label="Lin Xiang Yi 林湘儀">
          <span class="line">Lin <span class="chip">X</span>iang</span>
          <span class="line">Yi<span class="cjk">林湘儀</span></span>
        </h1>
        <p class="lead">{profile.tagline}</p>
        <div class="actions">
          <a class="btn btn--fill" href="/works/">看作品</a>
          <a class="btn" href="/about/">關於我</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="featured">
    <div class="container">
      <div class="head"><h2>Selected</h2><span class="cjk">精選作品</span><Sparkle class="spark spark--head" size={22} /></div>
      <div class="prints">
        {featured.map((w, i) => (
          <article class="print">
            <a href={`/works/${w.slug}/`}>
              <figure class="sheet"><img src={w.images[0].src} alt={w.images[0].alt} loading={i < 2 ? 'eager' : 'lazy'} width={w.images[0].w} height={w.images[0].h} /></figure>
              <div class="note">
                <span class="num">{pad(works.indexOf(w) + 1)}</span>
                <h3>{w.title.replace('｜', '｜​')}</h3>
                <p class="muted">{categoryLabel(w.category)}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
      <div class="more"><a class="btn btn--ink" href="/works/">看全部 {listedWorks.length} 件作品</a></div>
    </div>
  </section>

  <section class="statement on-deep" aria-label="設計觀">
    <div class="container">
      <div class="statement__side">
        <Sparkle class="spark spark--accent" size={22} />
        <span class="muted">作品集自述</span>
      </div>
      <p class="vertical">設計不只是<br />把畫面做好看，</p>
      <p class="vertical">更重要的是<br />讓人一眼看到重點。</p>
    </div>
  </section>

  <section class="section story" id="story">
    <img class="story__cat" src="/works/jester-line-bg.webp" alt="" width="706" height="827" loading="lazy" />
    <div class="container">
      <div class="head"><h2>Story</h2><span class="cjk">我的路</span><Sparkle class="spark spark--head" size={22} /></div>
      <ol class="path">
        {path.map((s) => (
          <li>
            <span class="path__period">{s.period}</span>
            <span class="path__title">{s.title}</span>
          </li>
        ))}
      </ol>
      <p class="lead path__lead">我自幼喜歡繪畫，高中就讀廣告設計科，大學進入師大設計系平面設計組。我在意文字的編排，也在意版面如何讓人先看見重點。目前大四休學中，一邊工作，曾製作網頁視覺，也擔任過繪畫教學，之後打算返校完成學業。</p>
      <div class="actions"><a class="btn btn--ink" href="/about/">看完整的故事</a></div>
    </div>
  </section>
</Layout>
