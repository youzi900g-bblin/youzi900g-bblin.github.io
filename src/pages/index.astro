---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
const pad = (n: number) => String(n).padStart(2, '0');
---
<Layout>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <h1>{profile.name}</h1>
        <p class="lead">{profile.tagline}</p>
        <div class="actions">
          <a class="btn btn--ink" href="#works">看作品</a>
          <a class="btn" href={`mailto:${profile.email}`}>寄信給我</a>
        </div>
      </div>
      <figure class="frame" style="margin:0">
        <img src="/works/portrait.jpg" alt="林湘儀的自畫像插畫" width="1040" height="770" />
      </figure>
    </div>
  </section>

  <section class="section" id="works">
    <div class="container">
      <div class="section__head"><h2>作品</h2><span class="muted">{profile.projects.length} 件</span></div>
      <div class="cells">
        {profile.projects.map((p, i) => (
          <a class:list={['cell', i === 0 && 'cell--lead']} href={p.href} target="_blank" rel="noopener">
            {p.image && <span class="cell__img"><img src={p.image} alt={p.title} loading={i < 2 ? 'eager' : 'lazy'} width="1600" height="900" /></span>}
            <span class="cell__body">
              <span class="cell__num">{pad(i + 1)}</span>
              <h3>{p.title}</h3>
              <span>{p.description}</span>
              <span class="muted">{p.tags.join('、')}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section band--ink" id="about">
    <div class="container about">
      <h2>關於我</h2>
      <div>{profile.about.map((t) => <p>{t}</p>)}</div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="container">
      <div class="section__head"><h2>經歷</h2></div>
      <div class="table">
        {profile.experience.map((e) => (
          <div class="row">
            <div class="row__period">{e.period}</div>
            <div><h3>{e.role}</h3><span class="muted">{e.org}</span></div>
            <div>{e.summary}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="skills" style="padding-top:0">
    <div class="container">
      <div class="section__head"><h2>技能與背景</h2></div>
      <div class="facts">
        {profile.skills.map((g, i) => (
          <div class:list={['fact', i === 0 && 'fact--ink']}>
            <h3>{g.group}</h3>
            <ul>{g.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
        <div class="fact">
          <h3>學歷</h3>
          <ul>{profile.education.map((e) => <li>{e.school}<br /><span class="muted">{e.note}</span></li>)}</ul>
        </div>
        <div class="fact">
          <h3>證照</h3>
          <ul>{profile.certifications.map((c) => <li>{c}</li>)}</ul>
        </div>
        <div class="fact">
          <h3>語言</h3>
          <ul>{profile.languages.map((l) => <li>{l}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section contact" id="contact">
    <div class="container">
      <h2>聯絡</h2>
      <a class="contact__mail" href={`mailto:${profile.email}`}>{profile.email}</a>
      <div class="actions">
        {profile.links.map((l) => <a class="btn" href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
      </div>
    </div>
  </section>
</Layout>
