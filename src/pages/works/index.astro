---
import Layout from '../../layouts/Layout.astro';
import Sparkle from '../../components/Sparkle.astro';
import Icon from '../../components/Icon.astro';
import { works, categories, categoryLabel } from '../../data/works';
const pad = (n: number) => String(n).padStart(2, '0');
const counts = Object.fromEntries(categories.map((c) => [c.id, c.id === 'all' ? works.length : works.filter((w) => w.category === c.id).length]));
---
<Layout title="作品" description="林湘儀的作品：插畫、平面設計、字體設計、影音動態、遊戲企劃與編輯設計。">
  <section class="section page-head">
    <div class="container">
      <div class="head"><h1>Works</h1><span class="cjk">作品</span><Sparkle class="spark spark--head" size={22} /></div>
      <div class="filters" role="group" aria-label="作品分類">
        {categories.map((c) => (
          <button type="button" class="chipbtn" data-filter={c.id} aria-pressed={c.id === 'all' ? 'true' : 'false'}><Icon name={c.id} size={18} />{c.label}<span class="chipbtn__n">{counts[c.id]}</span></button>
        ))}
      </div>
      <p class="muted" id="count" aria-live="polite">共 {works.length} 件</p>
    </div>
  </section>

  <section class="section grid-sec">
    <div class="container">
      <ul class="wgrid">
        {works.map((w, i) => (
          <li class="wcard" data-cat={w.category}>
            <a href={`/works/${w.slug}/`}>
              <span class="wcard__img">
                <img src={`/works/tiles/${w.slug}.jpg`} alt="" loading={i < 6 ? 'eager' : 'lazy'} width="1200" height="900" />
                <span class="wcard__badge"><Icon name={w.category} size={18} /><span class="visually-hidden">{categoryLabel(w.category)}</span></span>
              </span>
              <span class="wcard__body">
                <span class="num">{pad(i + 1)}</span>
                <span class="wcard__text">
                  <h2>{w.title.replace('｜', '｜​')}</h2>
                  <span class="muted">{categoryLabel(w.category)}</span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.chipbtn'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.wcard'));
  const count = document.getElementById('count');
  function apply(id: string) {
    let n = 0;
    cards.forEach((c) => { const show = id === 'all' || c.dataset.cat === id; c.hidden = !show; if (show) n++; });
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === id)));
    if (count) count.textContent = `共 ${n} 件`;
    history.replaceState(null, '', id === 'all' ? location.pathname : `#${id}`);
  }
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter || 'all')));
  const start = location.hash.slice(1);
  if (start && buttons.some((b) => b.dataset.filter === start)) apply(start);
</script>
